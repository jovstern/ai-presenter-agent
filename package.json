{
  "name": "ai-presenter-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run format:check && npm --prefix agent-client run check && npm --prefix server run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm --prefix agent-client run build && npm --prefix server start",
    "e2e": "playwright test",
    "e2e:live": "sh e2e/make-prompts.sh && GEMINI_LIVE_E2E=1 playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
