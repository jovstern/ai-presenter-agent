{
  "name": "agent-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "watch": "vite build --watch",
    "lint": "cd .. && eslint --config agent-client/eslint.config.js agent-client sandbox target-app e2e playwright.config.js",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.worklet.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-toast": "1.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "5.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
